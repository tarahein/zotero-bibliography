  abstract = {Paola Cerdas 1 : conceptualization (equal); methodology (lead); software (lead); formal analysis (lead); writing-original draft (lead); writing-review and editing (lead). Allison Romero 1 : conceptualization (equal); investigation; writing-original draft (supporting); writing-review and editing (supporting). Gabriela Espinoza 1 : conceptualization (equal); writing-review and editing (supporting); supervision (lead); project administration(lead). ¹Universidad CENFOTEC, San José, Costa Rica I. ABTRACT This study analyzes public perception of President Rodrigo Chaves and the Executive Branch of Costa Rica, using natural language processing (NLP) techniques applied to news articles, replies, and posts (videos) on the X platform (formerly Twitter) and YouTube. News, replies to tweets related to the president or the Executive Branch, and comments from videos on the official YouTube channel of the Presidency were collected. Sentiment analysis models were implemented to classify news and comments as positive, negative, or neutral, with special attention given to local linguistic phenomena such as sarcasm, nicknames, and the use of emojis. Results show that on X, 82.04\% of the news related to the president and the government maintained a neutral tone, 12.51\% reflected negative sentiments-mainly on topics such as security, corruption, and presidential rhetoric-and 5.45\% presented a positive evaluation. In the replies, a frequent use of nicknames and sarcastic expressions was observed, aiming to ridicule the president and evidencing strategies of disapproval toward his figure. In contrast, comments on YouTube reflected a more positive perception, characterized using religious expressions and respectful terms towards the president, consolidating a narrative of support based on values of faith and patriotism. The analysis reveals a significant divergence in the perception of President Rodrigo Chaves and the Executive Branch depending on the social platform used and highlights the need to adapt NLP models to specific sociocultural contexts by integrating the detection of sarcasm, slang, and visual elements to improve sentiment analysis accuracy in studies of governmental perception.},
  keywords = {Colloquial Language,Executive Power,Natural Language Processing (NLP),President Rodrigo Chaves,Sarcasm,Sentiment Analysis,Social Media},
  file = {/Users/tarahein/Zotero/storage/MAM6G68T/Digital Narrative in Costa Rica Perception of President Rodrigo Chaves and the Executive Branch through X and YouTube, July 2024 to January 2025.pdf}
}

@article{zucco2013,
  title = {When {{Payouts Pay Off}}: {{Conditional Cash Transfers}} and {{Voting Behavior}} in {{Brazil}} 2002-10},
  author = {Zucco, Cesar},
  date = {2013},
  journaltitle = {American Journal of Political Science},
  volume = {57},
  number = {4},
  pages = {810--822},
  issn = {15405907},
  doi = {10.1111/ajps.12026},
  abstract = {This article estimates the electoral effects of conditional cash transfers (CCTs) in three presidential elections in Brazil. It analyzes municipal-level electoral results and survey data and employs matching techniques to reduce causal inference problems typical of observational studies. Results show that CCTs are associated with increased performance by the incumbent party presidential candidate in all three elections but that these effects have been reaped by incumbents from different parties. It also shows that CCTs have had no discernible impacts on party identification and the performance of incumbent parties in legislative elections. Together, these findings suggest that CCTs are significant in the short run, but lack the capacity to induce substantial long-term voter realignments. ©2013, Midwest Political Science Association.},
  file = {/Users/tarahein/Zotero/storage/CNP7AKTN/ajps.12026.pdf}
}

