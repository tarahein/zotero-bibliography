@article{prillaman.etal2023,
  title = {Strength in {{Numbers}}: {{How Women}}'s {{Groups Close India}}'s {{Political Gender Gap}}},
  author = {Prillaman, Soledad Artiz and Iversen, Torben and Pande, Rohini and Mcclendon, Gwyneth and Khan, Sarah and King, Gary and Mabud, Rakeen and Mar-Shall, John and Phillips, Jonathan and Berliner, Dan and Blair, Rob and Dunning, Thad and Laitin, David and Varshney, Ashutosh and Narain, Nivedita and Blaydes, Lisa},
  date = {2023},
  journaltitle = {American Journal of Political Science},
  volume = {67},
  number = {2},
  pages = {390--410},
  doi = {10.7910/DVN/7M6NIP},
  url = {https://doi.org/10.7910/DVN/7M6NIP.},
  abstract = {In India, there persists a striking gender gap in political participation. Women's political participation is important both on normative grounds of inclusion and because when women participate, politics changes. I develop a theoretical model of women's political behavior, arguing that women's lack of political participation is the result of the structure of women's political networks in patriarchal societies. I then evaluate the effect of expanding women's networks by lever-aging a natural experiment that created as-if random variation in access to women-only credit groups. Participation in these groups had a significant and substantial impact on women's political participation-women's attendance at public meetings doubled. I provide suggestive evidence of three mechanisms underlying this effect: (1) larger networks, (2) increased capacity for collective action within networks, and (3) development of civic skills. These findings contribute to our understanding of how networks affect political behavior and underlie gendered inequalities in political participation. E ven after de jure enfranchisement, the barriers to women's political participation seem insur-mountable, particularly in places where gender-biased social norms persist (Brulé 2020; Clayton 2015; Teele 2018). Women are underrepresented in positions of elected office and the bureaucracy, rally at lower rates, and make fewer demands on government than men (Chhibber 2002; Kruks-Wisner 2018; Robinson and Got-tlieb 2019). Today, women account for only 22\% of members of parliament across the globe and only 14\% in India. Women also remain underrepresented in political spaces, particularly in between elections. Nearly 20 years ago, Burns, Schlozman, and Verba (2001) called attention to the sizable gender gap in nonelectoral political participation in the United States, showing that women were 21 percentage points less likely to contact a government official and 17 percentage points less likely to be affiliated with a political organization than men. These differences pale compared to more recent gender gaps reported in Figure 1 for rural citizens in one state of India. Here, men were on average 47 percentage points more likely to say they had attended a village assembly meeting and 36 percentage points more likely to say they had contacted the local leader. 1 Existing models of women's political behavior highlight the importance of resources (Burns, Schlozman, and Verba 2001), bargaining power (Iversen and Rosen-bluth 1 These differences cannot be entirely attributed to differences in social desirability bias between men and women. Comparing responses to a list experiment intended to elicit sincere participation showed that men still reported attending village assembly meetings at twice the rate of women.},
  file = {/Users/tarahein/Zotero/storage/4RHJLGPL/Prillaman2023.pdf}
}

