@incollection{lynch1985,
  title = {The {{Origins}} of {{Spanish American Independence}}},
  booktitle = {The {{Cambridge History}} of {{Latin America}}},
  author = {Lynch, John},
  date = {1985-07-11},
  pages = {1--50},
  publisher = {Cambridge University Press},
