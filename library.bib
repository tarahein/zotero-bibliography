@article{krosnick.etal,
  title = {{{THE IMPACT OF}} "{{NO OPINION}}" {{RESPONSE OPTIONS ON DATA QUALITY NON-ATTITUDE REDUCTION OR AN INVITATION TO SATISFICE}}?},
  author = {Krosnick, Jon A and Holbrook, Allyson L and Berent, Matthew K and Carson, Richard T and Hanemann, W Michael and Kopp, Raymond J and Mitchell, Robert Cameron and Presser, Stanley and Ruud, Paul A and Smith, V Kerry and Moody, Wendy R and Green, Melanie C and Conaway, Michael},
  journaltitle = {Public Opinion Quarterly},
  volume = {66},
  pages = {371--403},
  doi = {0033-362X/2002/6603-0003$10.00},
  url = {https://academic.oup.com/poq/article/66/3/371/1836194},
  abstract = {According to many seasoned survey researchers, offering a no-opinion option should reduce the pressure to give substantive responses felt by respondents who have no true opinions. By contrast, the survey satisficing perspective suggests that no-opinion options may discourage some respondents from doing the cognitive work necessary to report the true opinions they do have. We address these arguments using data from nine experiments carried out in three household surveys. Attraction to no-opinion options was found to be greatest among respondents lowest in cognitive skills (as measured by educational attainment), among respondents answering secretly instead of orally, for questions asked later in a survey, and among respondents who devoted little effort to the reporting process. The quality of attitude reports obtained (as measured by overtime consistency and responsiveness to a question manipulation) was not compromised by the omission of no-opinion options. These results suggest that inclusion of no-opinion options in attitude measures may not enhance data quality and instead may preclude measurement of some meaningful opinions.},
  keywords = {★},
  file = {/Users/tarahein/Zotero/storage/KL4BYVAM/660371.pdf}
}

@report{kruks-wisner2011,
  title = {Making {{Claims}}: {{Citizenship}} and {{Service Delivery}} in {{Rural India}}},
  author = {Kruks-Wisner, Gabrielle},
  date = {2011},
  url = {http://ssrn.com/abstract=1945333https://ssrn.com/abstract=1945333Electroniccopyavailableat:http://ssrn.com/abstract=1945333Electroniccopyavailableat:https://ssrn.com/abstract=1945333Electroniccopyavailableat:http://ssrn.com/abstract=1945333},
  abstract = {How do poor citizens of the world's largest democracy seek and obtain resources from the state? This paper seeks to explain local variation in citizen-state relations in rural India by examining the diverse paths-direct, mediated, and contentious-through which citizens claim public goods and services from the state. Who makes claims, and claims of what nature? Why do different people-under roughly the same structural conditions-engage the state differently? Drawing on 18 months of fieldwork in rural Rajasthan, including 400 interviews and an original survey of 2210 households, I uncover striking individual-level variation in both the incidence and variety of claim-making practices both across socioeconomic groups set apart by class, caste, and gender, as well as within such groups. I argue that claim-making practices are conditioned by local institutions and opportunity structure, but that-within these structures-individuals develop diverse strategies through participation in distinct networks that aggregate interests, position potential brokers, and shape the flow of ideas within and across social cleavages. The paper concludes by asking what can be learned from different patterns of claim-making about citizen-state relations for democratic practice in rural India.},
  keywords = {★}
}

