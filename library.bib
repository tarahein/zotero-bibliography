@report{zotero-item-13284,
  title = {The {{Politics}} of {{Suburban Restrictivism}}},
  abstract = {America's suburbs have long opposed permissive zoning that would increase the supply and density of housing. The historical reason for this opposition is clear: White homeowners' dual pursuit of racially homogeneous communities and high property values. But existing research offers less insight into the contemporary reasons for the persistence of suburban restrictivism. To shed light on this question, I draw on a mixed-methods study to show that there is an important spatial dimension to suburbanites' density preferences, which is resilient to changes in local demographic characteristics. I first document this spatial dimension through surveys and data from residential zoning ballot measures, which show that contemporary suburbanites hold distinctly anti-density preferences and routinely vote against density at the ballot box. Then, I turn to in-depth interviews to reveal the contextual mechanisms underlying this behavior, showing that suburbanites continue to oppose density because of both latent opposition-a sense that pro-density policies do not address suburban homeowners' subjective conceptions of the housing crisis-and active opposition-concerns that pro-density policies represent urban encroachment into historically protected low-density suburbs. By identifying and explanation this contextual dimension of suburban opposition to housing, these findings help explain the persistence of suburban restrictivism despite demographic and political change.},
  file = {/Users/tarahein/Zotero/storage/TC96366L/PoliticsofAdvantage.pdf}
}

